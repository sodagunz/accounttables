rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ledgerRef(ledgerId) {
      return /databases/$(database)/documents/ledgers/$(ledgerId);
    }

    function isLedgerMember(ledgerId) {
      return signedIn()
        && exists(ledgerRef(ledgerId))
        && request.auth.uid in get(ledgerRef(ledgerId)).data.memberUids;
    }

    function isLedgerOwner(ledgerId) {
      return signedIn()
        && exists(ledgerRef(ledgerId))
        && get(ledgerRef(ledgerId)).data.ownerUid == request.auth.uid;
    }

    function invitedToLedger() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email in resource.data.invitedEmails;
    }

    function hasLedgerIndex(ledgerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/userLedgers/$(request.auth.uid)/ledgers/$(ledgerId));
    }

    function isPersonalLedger(ledgerId) {
      return signedIn() && ledgerId == request.auth.uid;
    }

    match /ledgers/{ledgerId} {
      allow create: if signedIn()
        && ledgerId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      allow read: if isPersonalLedger(ledgerId)
        || isLedgerMember(ledgerId)
        || hasLedgerIndex(ledgerId);
      allow update: if isLedgerMember(ledgerId)
        || isLedgerOwner(ledgerId)
        || isPersonalLedger(ledgerId)
        || invitedToLedger();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /expenses/{expenseId} {
        allow read, write: if isLedgerMember(ledgerId);
      }

      match /accounts/{accountId} {
        allow read, write: if isLedgerMember(ledgerId);
      }

      match /events/{eventId} {
        allow read, write: if isLedgerMember(ledgerId);
      }
    }

    match /userLedgers/{uid}/ledgers/{ledgerId} {
      allow read, list, create, update: if signedIn() && uid == request.auth.uid;
      allow delete: if signedIn()
        && (uid == request.auth.uid || isLedgerOwner(resource.data.ledgerId));
    }

    match /emailInvites/{email}/ledgers/{ledgerId} {
      allow read, list, delete: if signedIn()
        && (request.auth.token.email == email || isLedgerOwner(ledgerId));
      allow create, update: if isLedgerOwner(ledgerId);
    }
  }
}
